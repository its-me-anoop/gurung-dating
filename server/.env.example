# Copy to `.env` and adjust. Everything here has a working default for local
# development except JWT_SECRET in production, which the server refuses to start
# without.

NODE_ENV=development
PORT=4000

# SQLite by default so there is nothing to install. The path is relative to the
# `server/` directory.
DATABASE_URL="file:./dev.db"

# Sign the access tokens. MUST be changed for production — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded photos are written, relative to `server/`.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=6291456
MAX_PHOTOS_PER_USER=8

# Minimum age to register.
MIN_AGE=18

# Development conveniences. Both should be false in production: photos should be
# reviewed by a moderator, and email addresses should be confirmed.
AUTO_APPROVE_PHOTOS=true
AUTO_VERIFY_EMAIL=true
